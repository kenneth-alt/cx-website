---
import Base from '../layouts/Base.astro';
import c from '../content/pages/about.json';
---
<Base title={c.title} description={c.description}>

  <section class="bay keep">
    <h1>{c.headline}</h1>
    <p class="say after-head">{c.standfirst}</p>
  </section>

  <section class="bay bay-sunk">
    <h2>{c.placeHeading}</h2>
    <p class="say after-head">{c.placeBody}</p>
  </section>

  <section class="bay">
    <h2>{c.beliefsHeading}</h2>
    <div class="ledger">
      {c.beliefs.map(item => (
        <article class="cell">
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bay bay-sunk">
    <h2>{c.closeHeading}</h2>
    <p class="say after-head">{c.closeBody}</p>
    <div class="act">
      <a class="push" href={c.closeAction.href}>{c.closeAction.label}</a>
    </div>
  </section>

</Base>
